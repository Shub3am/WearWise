{
  "name": "wearwise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "dbmate --migrations-dir db/migrations --no-dump-schema up",
    "db:rollback": "dbmate --migrations-dir db/migrations --no-dump-schema rollback"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:",
    "dbmate": "catalog:"
  }
}
